rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /responses/{responseId} {
      // Kdokoliv může vytvořit novou odpověď (odeslání dotazníku), ale nesmí nic číst,
      // upravovat ani mazat cizí odpovědi.
      allow create: if request.resource.data.keys().hasAll(['answers', 'submittedAt'])
                    && request.resource.data.answers is map;

      // Číst, upravovat nebo mazat odpovědi smí jen přihlášený admin (team leader).
      allow read, update, delete: if request.auth != null
                    && request.auth.uid == "vuGwoJfDNMfQIrEkEK44TBZvYmN2";
    }
  }
}
